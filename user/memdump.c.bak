#include "kernel/types.h"
#include "user.h"
#include "fcntl.h"

#define MAXIN 4096

void
memdump(char *fmt, char *data)
{
  unsigned char *p = (unsigned char *)data;
  char *f;

  for (f = fmt; *f; f++) {
    switch (*f) {
    case 'i': { // 4 bytes -> 32-bit int
      unsigned int v =
        (unsigned int)p[0]
        | ((unsigned int)p[1] << 8)
        | ((unsigned int)p[2] << 16)
        | ((unsigned int)p[3] << 24);
      printf("%d\n", (int)v);
      p += 4;
      break;
    }
    case 'h': { // 2 bytes -> 16-bit int
      unsigned int v =
        (unsigned int)p[0]
        | ((unsigned int)p[1] << 8);
      printf("%d\n", (int)v);
      p += 2;
      break;
    }
    case 'c': { // 1 byte -> char
      printf("%c\n", *p);
      p += 1;
      break;
    }
    case 'p': { // pointer (4 bytes)
      unsigned int v =
        (unsigned int)p[0]
        | ((unsigned int)p[1] << 8)
        | ((unsigned int)p[2] << 16)
        | ((unsigned int)p[3] << 24);
      printf("%p\n", (void*)v);
      p += 4;
      break;
    }
    case 's': { // string until \0
      printf("%s\n", (char*)p);
      p += strlen((char*)p) + 1;
      break;
    }
    }
  }
}

int
main(int argc, char *argv[])
{
  static char buf[MAXIN];

  if(argc < 2){
    printf("Usage: memdump fmt_string\n");
    exit(0);
  }

  // read from stdin into buf
  int n = read(0, buf, sizeof(buf));
  if (n < 0) {
    printf("memdump: read error\n");
    exit(1);
  }

  memdump(argv[1], buf);
  exit(0);
}
